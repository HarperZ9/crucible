{
  "mcpServers": {
    "crucible": {
      "command": "python3",
      "args": [
        "-I",
        "-S",
        "-B",
        "${CLAUDE_PLUGIN_ROOT}/server/serve.py",
        "--workspace",
        "${user_config.workspace}",
        "--process-consent=${user_config.process_consent}",
        "--measure-command=${user_config.measure_command}"
      ],
      "env": {}
    }
  }
}
